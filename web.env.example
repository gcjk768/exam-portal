# Copy to web.env and fill in. Never commit web.env.
# Claude for the tutor diagrams, study cards and coach note (same as the bots):
# `claude setup-token` on a logged-in PC, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# sonnet | haiku | opus
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=180
TZ=Asia/Singapore
# Listening port inside the container (compose maps 3003 to it).
PORT=8000
